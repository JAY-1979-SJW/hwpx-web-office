# hwpx-ro-view-engine — HWPX 읽기전용(RO-VIEW) 렌더 서비스
# g2b가 나라장터 첨부 HWPX를 텍스트 추출 대신 표/병합셀/문단순서 보존된
# HTML로 받아 iframe에 그대로 표시하기 위해 호출하는 내부 마이크로서비스.
FROM python:3.11-slim

WORKDIR /app

COPY scripts/hwpx/web_office/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY scripts/hwpx /app/scripts/hwpx

EXPOSE 8090
CMD ["python", "-m", "uvicorn", "scripts.hwpx.web_office.service:app", "--host", "0.0.0.0", "--port", "8090"]
